DATABASE_URL=postgres://khp:khp@localhost:5432/khp
REDIS_URL=redis://localhost:6379
PORT=3000
# Provider selection. SMS_PROVIDER: fake | africastalking. Payments stay fake until a vendor is chosen.
SMS_PROVIDER=fake
PAYMENTS_PROVIDER=fake

# Sign-in codes (slice S4.5). Channels are tried in this order; WhatsApp is used only when configured.
# OTP_CHANNELS=whatsapp,sms
# Hard stop on paid sign-in messages per rolling 24 hours (WhatsApp + SMS together)
# OTP_DAILY_CAP=2000
# Up to 5 TEST numbers whose code goes to the server log instead of a phone. Never put a real customer here.
# DEV_OTP_ALLOWLIST=0702461238

# Africa's Talking (SMS_PROVIDER=africastalking). Sandbox username is "sandbox"; AT_ENV must be "live" in production.
# AT_ENV=sandbox
# AT_USERNAME=
# AT_API_KEY=            # SECRET: Railway variable only
# AT_SENDER_ID=ZURIHOME  # only after the sender name is approved; 1 to 11 letters/digits

# WhatsApp Business (Meta Cloud API, or a partner exposing the same API via WHATSAPP_API_BASE)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN= # SECRET: Railway variable only
# WHATSAPP_TEMPLATE=zuri_login_code
# WHATSAPP_TEMPLATE_LANG=en
# Auth (generate long random values; never commit real ones)
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
OTP_PEPPER=change-me-to-another-random-string-32-plus
OTP_RESEND_COOLDOWN_SEC=30
APP_ENV=development        # development | staging | production (production needs a real channel or DEV_OTP_ALLOWLIST)
# Serverless (Vercel): scheduled jobs call /internal/cron/* with this secret; unset = endpoints refuse everything
CRON_SECRET=change-me-long-random
# Browser origins allowed to call the API, comma-separated (the dashboard URL)
CORS_ORIGINS=http://localhost:3001
# Serverless: keep pools tiny; point DATABASE_URL at the provider's pooled connection string
PG_POOL_MAX=3
# CA certificate (PEM text, including BEGIN/END lines) for verified TLS to the database.
# Supabase: Project Settings > Database > SSL Configuration > Download certificate. The certificate is public, not secret.
DATABASE_SSL_CA=

# Railway: set REDIS_IP_FAMILY=6 only if the API cannot reach Redis over Railway's private network (verify on first deploy)
REDIS_IP_FAMILY=

# File storage (slice S2). Both are needed; without them file features are switched off.
# SUPABASE_URL is your project address (https://<project-ref>.supabase.co). SUPABASE_SECRET_KEY is a SECRET: set it only as a Railway variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=property-files

# T2 (video and location verification). OFF unless set to true. Keep it off in production until your advocate has cleared
# the handling of video, voice and location data. Turn it on only for test properties with test footage.
T2_ENABLED=false
